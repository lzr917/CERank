{
  "sequence_length": 50,
  "hidden_size": 256,
  "num_blocks": 2,
  "num_heads": 1,
  "gnn_layers": 1,
  "dropout": 0.2,
  "leaky": 0.1,
  "native_lambda": 0.7,
  "num_train_negatives": 300,
  "num_epochs": 100,
  "patience": 10,
  "batch_size": 128,
  "eval_batch_size": 256,
  "num_workers": 4,
  "prefetch_factor": 2,
  "pin_memory": true,
  "learning_rate": 0.001,
  "weight_decay": 0.0005,
  "grad_clip": 5.0,
  "log_every_steps": 50,
  "num_eval_negatives": 999,
  "selection_metric": "ndcg@10"
}
